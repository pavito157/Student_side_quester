{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AnywhereLocation": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "anywhere",
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "AnywhereLocation",
      "type": "object"
    },
    "BudgetConstraints": {
      "additionalProperties": false,
      "properties": {
        "minDollars": {
          "default": 0,
          "minimum": 0,
          "title": "Mindollars",
          "type": "number"
        },
        "maxDollars": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxdollars"
        },
        "maxExclusive": {
          "default": false,
          "title": "Maxexclusive",
          "type": "boolean"
        }
      },
      "title": "BudgetConstraints",
      "type": "object"
    },
    "Coordinates": {
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "title": "Coordinates",
      "type": "object"
    },
    "CurrentLocation": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "current",
          "title": "Mode",
          "type": "string"
        },
        "coordinates": {
          "$ref": "#/$defs/Coordinates"
        },
        "accuracyMeters": {
          "exclusiveMinimum": 0,
          "title": "Accuracymeters",
          "type": "number"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "mode",
        "coordinates",
        "accuracyMeters"
      ],
      "title": "CurrentLocation",
      "type": "object"
    },
    "GeneratedQuestProposal": {
      "additionalProperties": false,
      "description": "Gemini proposes content and a place label, never trusted GPS or rewards.",
      "properties": {
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "steps": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "locationName": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Locationname",
          "type": "string"
        },
        "locationAddress": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Locationaddress",
          "type": "string"
        },
        "estimatedMinutes": {
          "exclusiveMinimum": 0,
          "title": "Estimatedminutes",
          "type": "integer"
        },
        "estimatedCostDollars": {
          "minimum": 0,
          "title": "Estimatedcostdollars",
          "type": "number"
        }
      },
      "required": [
        "title",
        "description",
        "steps",
        "locationName",
        "locationAddress",
        "estimatedMinutes",
        "estimatedCostDollars"
      ],
      "title": "GeneratedQuestProposal",
      "type": "object"
    },
    "NormalizedQuestPreferences": {
      "additionalProperties": false,
      "description": "Internal constraints; the frontend does not need to construct this shape.",
      "properties": {
        "location": {
          "discriminator": {
            "mapping": {
              "anywhere": "#/$defs/AnywhereLocation",
              "current": "#/$defs/CurrentLocation",
              "place": "#/$defs/PlaceLocation"
            },
            "propertyName": "mode"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AnywhereLocation"
            },
            {
              "$ref": "#/$defs/PlaceLocation"
            },
            {
              "$ref": "#/$defs/CurrentLocation"
            }
          ],
          "title": "Location"
        },
        "time": {
          "$ref": "#/$defs/TimeConstraints"
        },
        "budget": {
          "$ref": "#/$defs/BudgetConstraints"
        },
        "preferences": {
          "default": "",
          "maxLength": 4000,
          "title": "Preferences",
          "type": "string"
        },
        "goals": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Goals",
          "type": "array"
        },
        "vibe": {
          "anyOf": [
            {
              "$ref": "#/$defs/SelectedVibe"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "maxDistanceMiles": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxdistancemiles"
        }
      },
      "required": [
        "location",
        "time",
        "budget"
      ],
      "title": "NormalizedQuestPreferences",
      "type": "object"
    },
    "PlaceLocation": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "place",
          "title": "Mode",
          "type": "string"
        },
        "label": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "placeId": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Placeid"
        },
        "coordinates": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coordinates"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "mode",
        "label"
      ],
      "title": "PlaceLocation",
      "type": "object"
    },
    "ResolvedDestination": {
      "additionalProperties": false,
      "description": "Server resolver output; scope must be checked against Gainesville city-limit geography.",
      "properties": {
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        },
        "locationName": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Locationname",
          "type": "string"
        },
        "placeId": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Placeid"
        },
        "scope": {
          "const": "gainesville_city",
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "latitude",
        "longitude",
        "locationName",
        "scope"
      ],
      "title": "ResolvedDestination",
      "type": "object"
    },
    "SelectedVibe": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[^/]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "preferences": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Preferences",
          "type": "string"
        }
      },
      "required": [
        "preferences"
      ],
      "title": "SelectedVibe",
      "type": "object"
    },
    "TimeConstraints": {
      "additionalProperties": false,
      "properties": {
        "minMinutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minminutes"
        },
        "maxMinutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxminutes"
        }
      },
      "title": "TimeConstraints",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "mode": {
      "const": "generated",
      "default": "generated",
      "title": "Mode",
      "type": "string"
    },
    "saved": {
      "const": false,
      "default": false,
      "title": "Saved",
      "type": "boolean"
    },
    "filtersApplied": {
      "title": "Filtersapplied",
      "type": "boolean"
    },
    "destinationVerified": {
      "title": "Destinationverified",
      "type": "boolean"
    },
    "distanceStatus": {
      "enum": [
        "not_requested",
        "pending",
        "verified"
      ],
      "title": "Distancestatus",
      "type": "string"
    },
    "distanceMeters": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Distancemeters"
    },
    "destination": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResolvedDestination"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "quest": {
      "$ref": "#/$defs/GeneratedQuestProposal"
    },
    "normalizedPreferences": {
      "$ref": "#/$defs/NormalizedQuestPreferences"
    }
  },
  "required": [
    "filtersApplied",
    "destinationVerified",
    "distanceStatus",
    "message",
    "quest",
    "normalizedPreferences"
  ],
  "title": "GeneratedQuestResponse",
  "type": "object"
}
