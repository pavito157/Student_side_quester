# Backend settings. Copy to .env; never commit real secret values.
# Use the same Clerk instance as the frontend's publishable key.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_SECRET_KEY=replace-with-your-clerk-backend-secret
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://studentsidequest.web.app,https://studentsidequest.firebaseapp.com
# Keep this service-account JSON outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository/serviceAccountKey.json
# Gemini generation and photo review. Keep credentials on the backend.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=20
# Applied to newly saved quests only; Gemini and the browser cannot choose this.
QUEST_RADIUS_METERS=100

# Destination resolver: server key, separate from the VITE browser Maps key.
# Enable Places API (New); keep real credentials only in ignored .env.
GOOGLE_PLACES_API_KEY=replace-with-your-server-places-api-key
# City-sourced WGS84 Polygon/MultiPolygon Feature; see docs/destination_resolver.md.
GAINESVILLE_BOUNDARY_PATH=backend/data/gainesville-boundary.geojson

# Global event quests. Defaults are snapshotted when an admin publishes an event.
GLOBAL_QUEST_DEFAULT_XP=25
GLOBAL_QUEST_RADIUS_METERS=100
GLOBAL_QUEST_MAX_ACCURACY_METERS=50
GLOBAL_QUEST_GRACE_MINUTES=0
# gps requires precise GPS. honor explicitly disables GPS, but still checks event time.
GLOBAL_QUEST_VERIFICATION_MODE=gps
