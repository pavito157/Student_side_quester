# Backend settings. Copy to .env; never commit real secret values.
# Use the same Clerk instance as the frontend's publishable key.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_SECRET_KEY=replace-with-your-clerk-backend-secret
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Keep this service-account JSON outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository/serviceAccountKey.json
# Step 4 only. Get a Gemini key from Google AI Studio; keep it on the backend.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20
# Applied to newly saved quests only; Gemini and the browser cannot choose these.
QUEST_XP_REWARD=25
QUEST_RADIUS_METERS=100
